# Digivista Remote — Production Environment Configuration Template
# DO NOT commit real secrets or production credentials to source control.

# ==========================================
# Signaling & Relay Server Configuration
# ==========================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public WebSocket URL exposed to remote desktop clients
SIGNALING_PUBLIC_URL=wss://relay.digivista.com/ws/signaling

# Rate Limiting & Abuse Prevention
MAX_CONNECTIONS_PER_IP=100
MAX_MESSAGES_PER_SECOND=500
MAX_PAYLOAD_SIZE_BYTES=5242880

# Optional STUN / TURN Server Credentials (RFC 5389 / RFC 5766)
STUN_SERVER_URI=stun:stun.l.google.com:19302
TURN_SERVER_URI=
TURN_USERNAME=
TURN_CREDENTIAL=

# ==========================================
# Client & Host Application Defaults
# ==========================================
DIGIVISTA_DEFAULT_SIGNALING_URL=wss://relay.digivista.com/ws/signaling
DIGIVISTA_LOG_LEVEL=Information
DIGIVISTA_ENABLE_LOCAL_AUDIT=true
