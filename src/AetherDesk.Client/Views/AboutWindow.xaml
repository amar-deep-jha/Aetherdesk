<Window x:Class="AetherDesk.Client.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AetherDesk" Height="480" Width="440"
        Background="#0B0F19" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Border Background="#06B6D4" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="AD" Foreground="#0B0F19" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="AetherDesk" Foreground="#F9FAFB" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Ultra-Low Latency Secure Remote Desktop" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Text="Version 1.1.0-Release (Windows x64)" Foreground="#06B6D4" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Details Card -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROJECT ATTRIBUTION &amp; GOVERNANCE" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Engineered by the AetherDesk Core Architecture &amp; Engineering Team." Foreground="#E5E7EB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="INTELLECTUAL PROPERTY &amp; COPYRIGHT" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="© 2026 AetherDesk Project Contributors. All rights reserved." Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="SECURITY &amp; ENCRYPTION ARCHITECTURE" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="End-to-End Encryption (E2EE) with Curve25519 ECDH key derivation and authenticated AES-256-GCM cipher streaming over AetherDesk Binary Protocol (ADBP)." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <TextBlock Text="THIRD-PARTY OPEN SOURCE NOTICES" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="• Microsoft .NET Runtime (MIT License)&#x0a;• SQLite Database Engine (Public Domain)&#x0a;• SQLitePCLRaw (Apache License 2.0)&#x0a;• System.IO.Hashing (MIT License)" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0" />

                    <TextBlock Text="OFFICIAL RESOURCES &amp; CONTACT" Foreground="#6B7280" FontSize="10" FontWeight="Bold" Margin="0,12,0,6" />
                    <TextBlock Text="• Web Portal: https://aetherdesk-sigma.vercel.app/&#x0a;• Security Contact: security@aetherdesk.io&#x0a;• Code Repository: github.com/amar-deep-jha/Aetherdesk" Foreground="#06B6D4" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Close Button -->
        <Button Grid.Row="2" Content="Close" Click="BtnClose_Click" Background="#1F2937" Foreground="#F3F4F6" FontWeight="SemiBold" BorderBrush="#374151" Padding="16,8" HorizontalAlignment="Right" Cursor="Hand" />
    </Grid>
</Window>
