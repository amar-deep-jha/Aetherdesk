<Window x:Class="AetherDesk.Client.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherDesk - Remote Session Viewport" Height="768" Width="1024"
        Background="#0B0F19" WindowStartupLocation="CenterScreen"
        Focusable="True" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Top Edge Trigger for Auto-Hiding Toolbar in Fullscreen -->
        <Border x:Name="TopHoverTrigger" Grid.Row="0" Grid.ColumnSpan="2" Height="6" Background="Transparent" VerticalAlignment="Top" Panel.ZIndex="100" MouseEnter="TopHoverTrigger_MouseEnter" Visibility="Collapsed" />

        <!-- Top Session Toolbar (Supports Pinned & Auto-Hiding) -->
        <Border x:Name="PnlTopToolbar" Grid.Row="0" Grid.ColumnSpan="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,6" Panel.ZIndex="99" MouseLeave="PnlTopToolbar_MouseLeave">
            <DockPanel VerticalAlignment="Center">
                <!-- Left session metadata -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtPartnerId" Text="Partner: 000 000 000" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="E2EE AES-256-GCM" Foreground="#06B6D4" FontSize="11" FontWeight="Medium" />
                    </Border>
                    <TextBlock x:Name="TxtTelemetry" Text="FPS: 0.0 | 0.0 KB/s" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox x:Name="CmbMonitors" Background="#1F2937" Foreground="#F3F4F6" BorderBrush="#374151" Padding="6,3" SelectionChanged="CmbMonitors_SelectionChanged" Visibility="Collapsed" ToolTip="Select remote display" />
                </StackPanel>

                <!-- Right controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Ctrl+Alt+Del" Click="BtnCtrlAltDel_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Send Ctrl+Alt+Del" />
                    <Button Content="Win" Click="BtnWinKey_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Send Windows Key" />
                    <Button Content="Lock" Click="BtnLock_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Lock workstation" />
                    <Button Content="Screenshot" Click="BtnScreenshot_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Save screenshot to Desktop" />
                    <Button x:Name="BtnDisplayMode" Content="Fit to Window" Click="BtnDisplayMode_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Cycle Display Scaling (Fit to Window / Fill Screen / Original 1:1)" />
                    <Button x:Name="BtnFullScreen" Content="Fullscreen (F11)" Click="BtnFullScreen_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Toggle True Full-Screen Mode (F11)" />
                    <Button x:Name="BtnDiagnostics" Content="Diagnostics" Click="BtnDiagnostics_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Show Real-Time Diagnostics &amp; Telemetry" />
                    <Button Content="Files" Click="BtnFileTransfer_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Open File Transfer Manager" />
                    <Button x:Name="BtnToggleChat" Content="Chat" Click="BtnToggleChat_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="Open In-Session Chat" />
                    <Button x:Name="BtnPinToolbar" Content="📌" Click="BtnPinToolbar_Click" Background="#1F2937" Foreground="#9CA3AF" BorderBrush="#374151" Padding="6,4" Margin="0,0,8,0" Cursor="Hand" ToolTip="Pin toolbar in full-screen" />
                    <Button Content="Disconnect" Click="BtnDisconnect_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="12,4" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Center Remote Display Viewport -->
        <ScrollViewer x:Name="SvViewport" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#030712">
            <Grid Background="#030712" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImgViewport" Stretch="Uniform"
                       MouseMove="ImgViewport_MouseMove"
                       MouseDown="ImgViewport_MouseDown"
                       MouseUp="ImgViewport_MouseUp"
                       MouseWheel="ImgViewport_MouseWheel"
                       Cursor="Arrow"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Drop & Transfer In-Viewport Overlay Notification -->
                <Border x:Name="PnlDropOverlay" Background="#CC111827" BorderBrush="#06B6D4" BorderThickness="2" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtDropOverlay" Text="Uploading dropped file..." Foreground="#F9FAFB" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- In-Session Diagnostics Overlay -->
        <Border x:Name="PnlDiagnostics" Grid.Row="1" Grid.Column="0" Background="#F0111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Width="340" Visibility="Collapsed" Panel.ZIndex="150">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Session Diagnostics" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left" />
                    <Button Content="✕" Click="BtnCloseDiagnostics_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right" Cursor="Hand" />
                </DockPanel>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Security:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock Text="E2EE AES-256-GCM" Foreground="#10B981" FontWeight="SemiBold" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Transport Route:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtTransport" Text="Relayed (Railway WSS)" Foreground="#06B6D4" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Round-Trip Time (RTT):" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtRtt" Text="0 ms" Foreground="#F3F4F6" FontWeight="Medium" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Framerate (FPS):" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtFps" Text="0.0 FPS" Foreground="#F3F4F6" FontWeight="Medium" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Bandwidth Rate:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtBandwidth" Text="0.0 Kbps" Foreground="#F3F4F6" FontWeight="Medium" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Remote Display:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtResolution" Text="1920 x 1080" Foreground="#F3F4F6" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Scaling Mode:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtDisplayMode" Text="Fit to Window" Foreground="#F3F4F6" FontSize="12" Grid.Column="1" />
                </Grid>

                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Packet Quality:" Foreground="#9CA3AF" FontSize="12" />
                    <TextBlock x:Name="DiagTxtLoss" Text="Optimal (0.0% loss)" Foreground="#10B981" FontSize="12" Grid.Column="1" />
                </Grid>

                <Button Content="Copy Diagnostics Report" Click="BtnCopyDiagnostics_Click" Background="#1F2937" Foreground="#06B6D4" BorderBrush="#374151" Margin="0,12,0,0" Padding="8,6" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Right Chat Sidebar (Collapsible) -->
        <Border x:Name="ChatSidebar" Grid.Row="1" Grid.Column="1" Width="300" Background="#111827" BorderBrush="#1F2937" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1F2937" Padding="10,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="In-Session Chat" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <Button Content="✕" Click="BtnCloseChat_Click" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" DockPanel.Dock="Right" HorizontalAlignment="Right" Cursor="Hand" />
                    </DockPanel>
                </Border>

                <ListBox x:Name="LstChat" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="4" Padding="8,6" Margin="0,3">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding SenderName}" Foreground="#06B6D4" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding FormattedTime}" Foreground="#6B7280" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="#F9FAFB" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtChatInput" Grid.Column="0" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8,6" KeyDown="TxtChatInput_KeyDown" />
                    <Button Content="Send" Grid.Column="1" Click="BtnSendChat_Click" Background="#06B6D4" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>