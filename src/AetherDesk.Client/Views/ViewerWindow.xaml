<Window x:Class="AetherDesk.Client.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherDesk - Remote Session Viewport" Height="768" Width="1024"
        Background="#0B0F19" WindowStartupLocation="CenterScreen"
        Focusable="True" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Top Session Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Left session metadata -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtPartnerId" Text="Partner: 000 000 000" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Background="#1F2937" CornerRadius="4" Padding="6,2" Margin="0,0,12,0">
                        <TextBlock Text="E2EE AES-256-GCM" Foreground="#06B6D4" FontSize="11" FontWeight="Medium" />
                    </Border>
                    <TextBlock x:Name="TxtTelemetry" Text="FPS: 0.0 | 0.0 KB/s" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right controls -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="KeyFrame" Click="BtnKeyFrame_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" />
                    <Button Content="Fit Screen" Click="BtnFit_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" />
                    <Button Content="File Transfer" Click="BtnFileTransfer_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="10,5" Margin="0,0,6,0" Cursor="Hand" />
                    <Button Content="Chat" Click="BtnToggleChat_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="10,5" Margin="0,0,12,0" Cursor="Hand" />
                    <Button Content="Disconnect" Click="BtnDisconnect_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="14,6" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Center Remote Display Viewport -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#030712">
            <Grid Background="#030712" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="ImgViewport" Stretch="Uniform"
                       MouseMove="ImgViewport_MouseMove"
                       MouseDown="ImgViewport_MouseDown"
                       MouseUp="ImgViewport_MouseUp"
                       MouseWheel="ImgViewport_MouseWheel"
                       Cursor="Cross" />
            </Grid>
        </ScrollViewer>

        <!-- Right Chat Sidebar (Collapsible) -->
        <Border x:Name="ChatSidebar" Grid.Row="1" Grid.Column="1" Width="300" Background="#111827" BorderBrush="#1F2937" BorderThickness="1,0,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1F2937" Padding="10,0">
                    <TextBlock Text="In-Session Chat" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </Border>

                <ListBox x:Name="LstChat" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#E5E7EB" Margin="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding SenderName}" Foreground="#06B6D4" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Text}" Foreground="#F9FAFB" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtChatInput" Grid.Column="0" Background="#1F2937" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8,6" KeyDown="TxtChatInput_KeyDown" />
                    <Button Content="Send" Grid.Column="1" Click="BtnSendChat_Click" Background="#06B6D4" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Cursor="Hand" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
