<Window x:Class="AetherDesk.Client.Views.HostControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherDesk - Active Session Control" Height="420" Width="360"
        Background="#0B0F19" WindowStartupLocation="Manual" Top="40" Left="40"
        Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Session Active" Foreground="#F9FAFB" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="#1F2937" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="E2EE" Foreground="#06B6D4" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Partner Metadata & Permissions -->
        <Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="TxtPartnerId" Text="Partner: 000 000 000" Foreground="#F3F4F6" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                <TextBlock x:Name="TxtTransferStatus" Text="Ready - No active transfers" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
                <WrapPanel>
                    <Border Background="#1F2937" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                        <TextBlock Text="Remote Input" Foreground="#10B981" FontSize="10" FontWeight="Medium" />
                    </Border>
                    <Border Background="#1F2937" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                        <TextBlock Text="Clipboard Sync" Foreground="#06B6D4" FontSize="10" FontWeight="Medium" />
                    </Border>
                    <Border Background="#1F2937" CornerRadius="3" Padding="6,2" Margin="0,0,4,4">
                        <TextBlock Text="File Sharing" Foreground="#3B82F6" FontSize="10" FontWeight="Medium" />
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- In-Session Chat Message History -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Live In-Session Chat" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="LstChat" Grid.Row="1" Background="#030712" BorderThickness="0" Foreground="#E5E7EB">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding SenderName}" Foreground="#06B6D4" FontSize="10" FontWeight="SemiBold" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding FormattedTime}" Foreground="#6B7280" FontSize="9" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="#F9FAFB" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Chat Input Field -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtChatInput" Grid.Column="0" Background="#111827" Foreground="#FFFFFF" BorderBrush="#374151" Padding="8,6" KeyDown="TxtChatInput_KeyDown" />
            <Button Content="Send" Grid.Column="1" Click="BtnSendChat_Click" Background="#06B6D4" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Cursor="Hand" />
        </Grid>

        <!-- Disconnect Button -->
        <Button Grid.Row="4" Content="End Remote Session" Click="BtnDisconnect_Click" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Padding="12,8" Cursor="Hand" ToolTip="Immediately kick remote viewer and terminate session" />
    </Grid>
</Window>