<Window x:Class="AetherDesk.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherDesk - Network &amp; Security Settings" Height="420" Width="520"
        Background="#0B0F19" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Network &amp; Security Settings" Foreground="#F9FAFB" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Configure signaling server connection for multi-PC testing." Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- Server URL -->
            <TextBlock Text="Signaling &amp; Relay Server URL" Foreground="#D1D5DB" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="TxtServerUrl" Background="#111827" Foreground="#FFFFFF" BorderBrush="#374151" Padding="10,8" FontSize="13" FontFamily="Consolas" />
            <TextBlock Text="Tip: For connecting from a partner PC on the same Wi-Fi/LAN, use: ws://YOUR_PC_IP:5000/ws/signaling" Foreground="#06B6D4" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,16" />

            <!-- Unattended Password -->
            <TextBlock Text="Unattended Access Password" Foreground="#D1D5DB" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <PasswordBox x:Name="PbUnattendedPassword" Background="#111827" Foreground="#FFFFFF" BorderBrush="#374151" Padding="10,8" FontSize="13" />
            <TextBlock Text="Leave blank to keep existing password. Hashed using PBKDF2-SHA256." Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Bottom Actions -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Reset to Localhost" Click="BtnResetLocalhost_Click" Background="#1F2937" Foreground="#9CA3AF" BorderBrush="#374151" Padding="10,6" DockPanel.Dock="Left" Cursor="Hand" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#1F2937" Foreground="#E5E7EB" BorderBrush="#374151" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" />
                <Button Content="Save &amp; Apply" Click="BtnSave_Click" Background="#06B6D4" Foreground="#0B0F19" FontWeight="Bold" BorderThickness="0" Padding="18,6" Cursor="Hand" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
