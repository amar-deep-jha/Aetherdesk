# AetherDesk Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or credentials to source control.

# ==========================================
# Signaling & Relay Server Configuration
# ==========================================
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public WebSocket URL exposed to clients
SIGNALING_PUBLIC_URL=wss://aetherdesk-production.up.railway.app/ws/signaling

# Optional STUN / TURN Server Credentials (RFC 5389 / RFC 5766)
STUN_SERVER_URI=stun:stun.l.google.com:19302
TURN_SERVER_URI=turn:turn.aetherdesk.io:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate Limiting & Abuse Prevention
MAX_CONNECTIONS_PER_IP=50
MAX_MESSAGES_PER_SECOND=200

# ==========================================
# Client & Host Application Defaults
# ==========================================
AETHERDESK_DEFAULT_SIGNALING_URL=wss://aetherdesk-production.up.railway.app/ws/signaling
AETHERDESK_LOG_LEVEL=Information
AETHERDESK_ENABLE_LOCAL_AUDIT=true
